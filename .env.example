SECRET_KEY=change-this-to-a-random-hex-string

# Where session files are kept. Defaults to flask_session/ inside the checkout,
# wherever the process is started from; set this to keep sessions outside the
# code, under a directory the service user owns.
# SESSION_FILE_DIR=/var/lib/cti-transmute/flask-session
# BACKUP_DIR=/var/lib/cti-transmute/backups